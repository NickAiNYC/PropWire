{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/ledger", "destination": "/index.html" },
    { "source": "/audit", "destination": "/index.html" },
    { "source": "/verify", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=60, s-maxage=60" }
      ]
    }
  ]
}
