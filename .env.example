# Runtime mode. Production fails closed when required integrations are absent.
APP_ENV=production

# Comma-separated browser origins allowed to call the API.
ALLOWED_ORIGINS=https://propwire.vercel.app

# Required for paid entitlement checks in production.
WHOP_API_KEY=

# Required for privileged model-run and settlement operations.
ADMIN_TOKEN=
ADMIN_SETTLEMENT_KEY=

# Live data providers.
ODDS_API_KEY=
BALLDONTLIE_API_KEY=

# Explicit local-only escape hatch. Never set this in production.
PROPWIRE_ALLOW_DEV_AUTH_BYPASS=0
