# Runtime mode. Production fails closed when required integrations are absent.
APP_ENV=production
ENVIRONMENT=production
LOG_LEVEL=INFO

ALLOWED_ORIGINS=https://propwire.vercel.app,https://propwire-github.vercel.app

# Required for paid entitlement checks in production.
WHOP_API_KEY=

# Required for privileged model-run and settlement operations.
ADMIN_TOKEN=
ADMIN_SETTLEMENT_KEY=

# Live data providers.
ODDS_API_KEY=
BALLDONTLIE_API_KEY=

# ----------------------------------------------------------------------------
# Railway Multi-Service Worker Configuration (propwire-worker)
# ----------------------------------------------------------------------------
# Internal Railway Private Networking URL for the FastAPI web service.
# Do NOT use the public Vercel URL to avoid rate limits and egress latency.
PROPWIRE_INTERNAL_API_URL=http://propwire-web.railway.internal:8000

# Anti-Ban Proxy Rotation for nba_api Live PlayByPlay polling (5s cadence).
# Provide a comma-separated list of proxy URLs or a ScraperAPI key.
NBA_PROXY_URLS=
SCRAPER_API_KEY=

# Active NBA game IDs and polling cadence for the standalone worker daemon.
NBA_ACTIVE_GAME_IDS=2026_nba_mil_bos,2026_nba_gsw_sac
NBA_PBP_POLL_SECONDS=5.0

# Optional external Redis Streams & Postgres Truth Store (falls back to WAL/SQLite locally).
REDIS_URL=
DATABASE_URL=

# Discord & Telegram Alert Routing Webhook
# e.g. https://discord.com/api/webhooks/<id>/<token>
DISCORD_WEBHOOK_URL=
WEBHOOK_MIN_EDGE_GATE=4.0
WEBHOOK_POLYMARKET_ONLY=false

# Explicit local-only escape hatch. Never set this in production.
PROPWIRE_ALLOW_DEV_AUTH_BYPASS=0
