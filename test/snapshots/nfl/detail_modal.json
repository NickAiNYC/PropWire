{"#detailContent":{"innerHTML":"\n      <!-- Prominent Verdict Strip at Top: Line, Edge, Kelly Stake -->\n      <div class=\"detail-verdict-card\">\n        <div class=\"verdict-col\">\n          <span class=\"verdict-label\">Book Line</span>\n          <strong class=\"verdict-val font-mono\">OVER 34.5 <small class=\"text-dim\">(-110)</small></strong>\n          <span class=\"verdict-sub\">Fair 24.5</span>\n        </div>\n        <div class=\"verdict-col\">\n          <span class=\"verdict-label\">Edge</span>\n          <strong class=\"verdict-val font-mono text-accent\">+10.5%</strong>\n          <span class=\"verdict-sub\">+15.6% EV</span>\n        </div>\n        <div class=\"verdict-col\">\n          <span class=\"verdict-label\">Kelly Stake</span>\n          <strong class=\"verdict-val font-mono\">$0.00</strong>\n          <span class=\"verdict-sub\">0.00% cap</span>\n        </div>\n      </div>\n\n      <div class=\"detail-hero\">\n        <div class=\"detail-stat\">\n          <span>Book Offer</span>\n          <strong class=\"text-accent\">\n            <span class=\"hero-side-pill pill-over\">OVER</span>\n            34.5 <small class=\"odds-val\">-110</small>\n          </strong>\n          <small class=\"cell-sub\">DK · Unverified</small>\n        </div>\n        <div class=\"detail-stat detail-stat-fair\">\n          <div class=\"detail-stat-head\">\n            <span>Model Fair</span>\n            <span class=\"detail-stat-badge\">P(over fair) 50.0%</span>\n          </div>\n          <strong class=\"text-white\">24.5 <small class=\"text-dim\" style=\"font-size:11px;\">(μ 30.0)</small></strong>\n          <small class=\"cell-sub\">Continuous median · 47G baseline</small>\n        </div>\n        <div class=\"detail-stat metric-lock\"><span>Price check</span><strong><svg class=\"prop-icon icon-lock\" viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"3.5\" y=\"6.5\" width=\"9\" height=\"8\" rx=\"1.5\"/><path d=\"M5.5 6.5V4.5a2.5 2.5 0 015 0v2\"/></svg> +10.5%</strong><small class=\"cell-sub\">Stake 0.00%</small></div>\n      </div>\n\n      <div class=\"detail-sub-bar\">\n        <div class=\"detail-insight-banner\">\n          <strong>Quant Summary:</strong> Model fair sits at 24.5 yds (+15.6% EV on OVER 34.5 DK quote · Unverified).\n        </div>\n        <div class=\"detail-action-buttons\">\n          <button class=\"star-modal-btn \" type=\"button\" id=\"modalWatchlistBtn\" data-watch-player=\"00-0038621\">☆ Add to Watchlist</button>\n        </div>\n      </div>\n\n      \n      <div class=\"detail-section\">\n        <h3><svg class=\"prop-icon icon-surge\" viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M1.5 8h3l2-5 3.5 10 2.5-6 1.5 2.5 2-.5\"/></svg> Role Surge Breakdown</h3>\n        <div class=\"warning-box\" style=\"border-color: color-mix(in srgb, var(--accent) 55%, var(--line)); background: color-mix(in srgb, var(--accent) 12%, transparent); color: var(--text);\">\n          <strong>PROVISIONAL SURGE (Injury Vacancy)</strong>\n          <div style=\"margin-top:4px; font-size:12px; line-height:1.4;\">\n            <strong>Catalyst:</strong> Romeo Doubs (Shoulder OUT)<br>\n            <strong>Redistribution:</strong> +2.5 targets, +23.8 air yards (35.0% absorption)<br>\n            <span style=\"color:var(--muted)\"><strong>Risk factor:</strong> A.J. Brown target monopoly; CHI heavy 2-high bracket on slot crossers.</span>\n          </div>\n        </div>\n      </div>\n\n      <!-- Unified Price Discovery & 10% Gate Hurdle Timeline -->\n      \n      <div class=\"quant-ruler-card\">\n        <div class=\"quant-ruler-header\">\n          <span class=\"quant-ruler-title\">Price Discovery &amp; 10% Gate Hurdle</span>\n          <span class=\"quant-ruler-delta text-accent\">-10.0 yds vs Offer (OVER)</span>\n        </div>\n\n        <div class=\"quant-ruler-track-wrap\">\n          <svg class=\"quant-ruler-svg\" viewBox=\"0 0 100 44\" preserveAspectRatio=\"none\" aria-hidden=\"true\">\n            <!-- Base Axis Track -->\n            <rect x=\"0\" y=\"20\" width=\"100\" height=\"4\" rx=\"1.5\" fill=\"rgba(255,255,255,0.07)\" />\n            <!-- Market Steam Vector (Open -> Offer) -->\n            <rect x=\"66.3\" y=\"20\" width=\"18.5\" height=\"4\" fill=\"rgba(148, 163, 184, 0.35)\" />\n            <!-- Actionable Alpha Zone (Offer -> Hurdle) -->\n            <rect x=\"13.0\" y=\"19\" width=\"71.7\" height=\"6\" rx=\"1\" fill=\"rgba(132, 204, 22, 0.32)\" />\n            <!-- Sub-Gate Buffer Zone (Hurdle -> Fair) -->\n            <rect x=\"13.0\" y=\"20\" width=\"28.3\" height=\"4\" fill=\"rgba(245, 158, 11, 0.22)\" />\n          </svg>\n\n          <!-- Marker 1: Open Line -->\n          <div class=\"ruler-marker marker-open\" style=\"left:66.3%\">\n            <span class=\"marker-lbl\">OPEN</span>\n            <div class=\"marker-tick tick-open\"></div>\n            <span class=\"marker-val val-open\">30.2</span>\n          </div>\n\n          <!-- Marker 2: Live Book Offer (Staggered top when crowded) -->\n          <div class=\"ruler-marker marker-offer \" style=\"left:84.8%\">\n            <span class=\"marker-lbl lbl-offer\">OFFER</span>\n            <div class=\"marker-dot dot-offer\"></div>\n            <span class=\"marker-val val-offer\">34.5</span>\n          </div>\n\n          <!-- Marker 3: Gate Hurdle Target (Staggered bottom when crowded) -->\n          <div class=\"ruler-marker marker-hurdle \" style=\"left:13.0%\">\n            <span class=\"marker-lbl lbl-hurdle\">HURDLE</span>\n            <div class=\"marker-dot dot-hurdle\"></div>\n            <span class=\"marker-val val-hurdle\">18.0</span>\n          </div>\n\n          <!-- Marker 4: Model Fair Median -->\n          <div class=\"ruler-marker marker-fair\" style=\"left:41.3%\">\n            <span class=\"marker-lbl lbl-fair\">FAIR (P50)</span>\n            <div class=\"marker-dot dot-fair\"></div>\n            <span class=\"marker-val val-fair\">24.5</span>\n          </div>\n        </div>\n\n        <p class=\"quant-ruler-copy\">\n          Playable up to <span class=\"text-amber\">18.0 yds</span> before OVER edge drops below your <span class=\"text-white\">10%</span> execution gate.\n        </p>\n      </div>\n    \n\n      <!-- What-If Simulator + Teammate Ripple Preview -->\n      \n      <div class=\"scenario-box\">\n        <div class=\"scenario-header\">\n          <h4><svg class=\"prop-icon icon-surge\" viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" style=\"width:14px;height:14px;\"><path d=\"M1.5 8h3l2-5 3.5 10 2.5-6 1.5 2.5 2-.5\"/></svg> \"What-If\" Target Share Simulator</h4>\n          <button type=\"button\" class=\"scenario-reset-btn\" id=\"scenarioResetBtn\">Reset to Model (13.7%)</button>\n        </div>\n        <p style=\"font-size:11px; color:var(--muted); margin:0 0 8px;\">Adjust target share to simulate injury vacancies or usage changes.</p>\n        <div class=\"scenario-slider-row\">\n          <input type=\"range\" id=\"targetShareSlider\" min=\"0.05\" max=\"0.45\" step=\"0.01\" value=\"0.14\">\n          <span class=\"scenario-val\" id=\"scenarioShareVal\">14%</span>\n        </div>\n        <div class=\"scenario-results\">\n          <div class=\"scenario-result-item\"><span>Sim Targets</span><strong id=\"simTargetsVal\">4.6</strong></div>\n          <div class=\"scenario-result-item\"><span>Sim Yards</span><strong id=\"simYardsVal\">30.0</strong></div>\n          <div class=\"scenario-result-item\"><span>Sim Edge</span><strong id=\"simEdgeVal\" style=\"color:var(--accent);\">UNDER +10.5%</strong></div>\n        </div>\n        <div id=\"teammateRippleWrap\">\n          \n        <div class=\"teammate-ripple-bar\" id=\"teammateRipplePreview\">\n          <span class=\"ripple-lead\">Volume Concentration:</span>\n          <span class=\"ripple-text\">A. Brown (25.1%) · M. Hollins (20.5%)</span>\n        </div>\n        </div>\n      </div>\n    \n\n      <!-- Kelly Calculator with Gate Override -->\n      \n      <div class=\"kelly-calc-box\">\n        <div class=\"kelly-calc-header\">\n          <h4>\n            <svg class=\"prop-icon icon-volume\" viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" style=\"width:13px;height:13px;\"><path d=\"M2 10h3l3 4V2L5 6H2v4z\"/></svg>\n            Interactive Kelly Bet Sizing Calculator\n          </h4>\n          <span style=\"font: 600 10.5px/1 var(--mono); color: var(--muted);\">Kelly cap 3.0%</span>\n        </div>\n        <div class=\"kelly-calc-row\">\n          <label class=\"kelly-input-wrap\">\n            <span>Bankroll $</span>\n            <input type=\"number\" id=\"kellyBankrollInput\" min=\"100\" max=\"1000000\" step=\"100\" value=\"5000\">\n          </label>\n          <div class=\"kelly-result-card\">\n            <span class=\"kelly-stake-amt\" id=\"kellyWagerDollars\">$0.00</span>\n            <span class=\"kelly-stake-pct\" id=\"kellyWagerPct\">(0.00% of bankroll)</span>\n            \n          </div>\n        </div>\n      </div>\n    \n\n      <!-- 2-Column Institutional Spec Grid -->\n      <div class=\"detail-two-col\">\n        <div class=\"detail-col\">\n          \n      <div class=\"quant-card\">\n        <div class=\"quant-card-header\">\n          <span class=\"quant-card-title\">Opportunity Telemetry</span>\n          <span class=\"quant-card-sub\">Starting WR</span>\n        </div>\n        <div class=\"telemetry-grid\">\n          \n            <div class=\"telemetry-cell\">\n              <div class=\"telemetry-cell-header\">\n                <span class=\"telemetry-label\">Target share</span>\n                <div class=\"telemetry-vals\">\n                  <span class=\"telemetry-benchmark\">Rotational</span>\n                  <strong class=\"telemetry-value\">13.7%</strong>\n                </div>\n              </div>\n              <div class=\"telemetry-bar-track\">\n                <div class=\"telemetry-bar-fill\" style=\"width:39.1%\"></div>\n              </div>\n            </div>\n          \n            <div class=\"telemetry-cell\">\n              <div class=\"telemetry-cell-header\">\n                <span class=\"telemetry-label\">Air-yards share</span>\n                <div class=\"telemetry-vals\">\n                  <span class=\"telemetry-benchmark\">Intermediate</span>\n                  <strong class=\"telemetry-value\">13.6%</strong>\n                </div>\n              </div>\n              <div class=\"telemetry-bar-track\">\n                <div class=\"telemetry-bar-fill\" style=\"width:34.0%\"></div>\n              </div>\n            </div>\n          \n            <div class=\"telemetry-cell\">\n              <div class=\"telemetry-cell-header\">\n                <span class=\"telemetry-label\">aDOT</span>\n                <div class=\"telemetry-vals\">\n                  <span class=\"telemetry-benchmark\">Intermediate</span>\n                  <strong class=\"telemetry-value\">10.1 yds</strong>\n                </div>\n              </div>\n              <div class=\"telemetry-bar-track\">\n                <div class=\"telemetry-bar-fill\" style=\"width:63.0%\"></div>\n              </div>\n            </div>\n          \n            <div class=\"telemetry-cell\">\n              <div class=\"telemetry-cell-header\">\n                <span class=\"telemetry-label\">Catch rate</span>\n                <div class=\"telemetry-vals\">\n                  <span class=\"telemetry-benchmark\">vs 67% exp</span>\n                  <strong class=\"telemetry-value\">68.0%</strong>\n                </div>\n              </div>\n              <div class=\"telemetry-bar-track\">\n                <div class=\"telemetry-bar-fill\" style=\"width:80.0%\"></div>\n              </div>\n            </div>\n          \n            <div class=\"telemetry-cell\">\n              <div class=\"telemetry-cell-header\">\n                <span class=\"telemetry-label\">Yards / reception</span>\n                <div class=\"telemetry-vals\">\n                  <span class=\"telemetry-benchmark\">High Floor</span>\n                  <strong class=\"telemetry-value\">10.1 yds</strong>\n                </div>\n              </div>\n              <div class=\"telemetry-bar-track\">\n                <div class=\"telemetry-bar-fill\" style=\"width:56.1%\"></div>\n              </div>\n            </div>\n          \n            <div class=\"telemetry-cell\">\n              <div class=\"telemetry-cell-header\">\n                <span class=\"telemetry-label\">Sample size</span>\n                <div class=\"telemetry-vals\">\n                  <span class=\"telemetry-benchmark\">High Confidence</span>\n                  <strong class=\"telemetry-value\">47 games</strong>\n                </div>\n              </div>\n              <div class=\"telemetry-bar-track\">\n                <div class=\"telemetry-bar-fill\" style=\"width:100.0%\"></div>\n              </div>\n            </div>\n          \n        </div>\n      </div>\n    \n        </div>\n        <div class=\"detail-col\">\n          \n      <div class=\"quant-card\">\n        <div class=\"quant-card-header\">\n          <span class=\"quant-card-title\">Probability Edge Bridge</span>\n          <button type=\"button\" class=\"receipt-copy-pill\" id=\"copyReceiptBtn\" data-receipt=\"d5c1bc3e4872f5af\" title=\"Click to copy cryptographic receipt hash\">\n            <span class=\"receipt-dot\"></span>\n            <span class=\"receipt-hash\">#d5c1bc3e4872f5af</span>\n            <span class=\"receipt-copy-icon\">⧉</span>\n          </button>\n        </div>\n\n        <div class=\"bridge-body\">\n          <div class=\"bridge-legend\">\n            <span class=\"legend-mkt\">De-Vigged Mkt: <b class=\"val-mkt\">50.0%</b></span>\n            <span class=\"legend-vig\">Break-Even Vig: <b class=\"val-vig\">52.4%</b> <small>(-110)</small></span>\n            <span class=\"legend-model\">Model Win P: <b class=\"val-model\">60.5%</b></span>\n          </div>\n\n          <div class=\"bridge-track\">\n            <!-- Base Market Probability -->\n            <div class=\"bridge-seg-mkt\" style=\"width:50.0%\"></div>\n            <!-- Vig Tax -->\n            <div class=\"bridge-seg-vig\" style=\"left:50.0%; width:2.4%\"></div>\n            <!-- Net Positive Alpha -->\n            <div class=\"bridge-seg-alpha\" style=\"left:52.4%; width:8.14904761904761%\"></div>\n          </div>\n\n          <div class=\"bridge-footer\">\n            <span class=\"text-muted\">Vig drag: -2.4%</span>\n            <span class=\"text-accent font-bold\">True Edge: +10.5% (+8.1% over vig)</span>\n          </div>\n\n          <div class=\"specs-grid\">\n            <div><span>State:</span> <b>ingested</b></div>\n            <div><span>Source:</span> <b>DraftKings API (Fresh)</b></div>\n            <div><span>Gate Hurdle:</span> <b>10%</b></div>\n            <div><span>Kelly Cap:</span> <b>3.0%</b></div>\n          </div>\n        </div>\n      </div>\n    \n        </div>\n      </div>\n\n      <!-- Inline Execution Ticket (CLV Ledger) -->\n      \n      <div class=\"execution-ticket-box\">\n        <div class=\"ticket-header\">\n          <span class=\"ticket-title\"><svg class=\"prop-icon\" viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" style=\"width:13px;height:13px;\"><path d=\"M2.5 3.5h11a1 1 0 011 1v8a1 1 0 01-1 1h-11a1 1 0 01-1-1v-8a1 1 0 011-1z\"/><path d=\"M5.5 3.5v-1a1 1 0 011-1h4a1 1 0 011 1v1M8 7v4M6 9h4\"/></svg> Execution Ticket · CLV Ledger</span>\n          <span class=\"ticket-status text-muted\">Ready to Fill</span>\n        </div>\n        <div class=\"ticket-fields-row\">\n          <div class=\"ticket-field ticket-side-field\">\n            <span class=\"ticket-lbl\">Side</span>\n            <div class=\"ticket-side-group\" role=\"group\">\n              <button type=\"button\" class=\"side-toggle-btn active side-o\" id=\"ticketSideOver\">O</button>\n              <button type=\"button\" class=\"side-toggle-btn \" id=\"ticketSideUnder\">U</button>\n            </div>\n          </div>\n          <div class=\"ticket-field\">\n            <label class=\"ticket-lbl\" for=\"ticketLineInput\">Line</label>\n            <input type=\"number\" step=\"0.5\" id=\"ticketLineInput\" class=\"ticket-input\" value=\"34.5\">\n          </div>\n          <div class=\"ticket-field\">\n            <label class=\"ticket-lbl\" for=\"ticketOddsInput\">Odds</label>\n            <input type=\"text\" id=\"ticketOddsInput\" class=\"ticket-input\" value=\"-110\">\n          </div>\n          <div class=\"ticket-field\">\n            <label class=\"ticket-lbl\" for=\"ticketStakeInput\">Stake $</label>\n            <input type=\"number\" step=\"10\" id=\"ticketStakeInput\" class=\"ticket-input\" value=\"0.00\">\n          </div>\n          <button type=\"button\" class=\"ticket-confirm-btn \" id=\"ticketConfirmBtn\">\n            Confirm Log ↵\n          </button>\n        </div>\n      </div>\n    \n\n      <!-- Institutional 2-Column Terminal Specification Grid (Replacing Text-Heavy Footer) -->\n      <div class=\"spec-grid-card\">\n        <div class=\"spec-col spec-col-invalidation\">\n          <div class=\"spec-header\">\n            <span class=\"spec-title\">Invalidation &amp; Risk Envelope</span>\n            <span class=\"spec-tag tag-wind\">ENV: 18 MPH WIND</span>\n          </div>\n          <div class=\"spec-body\">\n            <div class=\"spec-meta-list\">\n              <div class=\"spec-meta-item\"><span class=\"spec-k\">Game Script:</span> <span class=\"spec-v\">NE spread 0.0</span></div>\n              <div class=\"spec-meta-item\"><span class=\"spec-k\">Venue / Env:</span> <span class=\"spec-v\">18 mph wind (CHI stadium)</span></div>\n              <div class=\"spec-meta-item\"><span class=\"spec-k\">Tail Risk:</span> <span class=\"spec-v\">Late inactive / unmodeled rotation</span></div>\n            </div>\n            \n            \n          </div>\n        </div>\n\n        <div class=\"spec-col spec-col-scope\">\n          <div class=\"spec-header\">\n            <span class=\"spec-title\">Fair-Line Specification</span>\n            <span class=\"spec-tag tag-model\">MODEL SPEC: CONTINUOUS MEDIAN</span>\n          </div>\n          <div class=\"spec-body\">\n            <div class=\"spec-meta-list\">\n              <div class=\"spec-meta-item\"><span class=\"spec-k\">Distribution:</span> <span class=\"spec-v\">Calibrated Continuous Log-Normal</span></div>\n              <div class=\"spec-meta-item\"><span class=\"spec-k\">P(Over Fair):</span> <span class=\"spec-v font-bold text-accent\">50.0%</span></div>\n              <div class=\"spec-meta-item\"><span class=\"spec-k\">Sample Base:</span> <span class=\"spec-v\">47 games prior · 2026</span></div>\n            </div>\n            <div class=\"spec-note\">Receiving-yards fair line is the calibrated continuous median, where P(over) is exactly 50.0%.</div>\n          </div>\n        </div>\n      </div>\n\n      <!-- Sticky Add To Ledger Bar pinned to bottom of bottom sheet -->\n      <div class=\"detail-sticky-bar\">\n        <div class=\"sticky-bar-info\">\n          <span class=\"sticky-verdict\">OVER 34.5 <small class=\"text-dim\">(-110)</small></span>\n          <span class=\"sticky-edge text-accent\">+10.5% edge · $0.00 (0.00%)</span>\n        </div>\n        <button type=\"button\" class=\"detail-sticky-log-btn \" id=\"modalStickyLogBtn\">\n          + Add to Ledger\n        </button>\n      </div>\n    ","textContent":""},"#detailMeta":{"innerHTML":"","textContent":"WR · NE @ CHI · Receiving yards"},"#detailTitle":{"innerHTML":"\n      <div class=\"detail-title-row\">\n        <div class