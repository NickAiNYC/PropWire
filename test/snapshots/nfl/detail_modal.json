{"#detailContent":{"innerHTML":"\n      <!-- Prominent Verdict Strip at Top: Line, Edge, Kelly Stake -->\n      <div class=\"detail-verdict-card\">\n        <div class=\"verdict-col\">\n          <span class=\"verdict-label\">Book Line</span>\n          <strong class=\"verdict-val font-mono\">OVER 2.5 <small class=\"text-dim\">(-110)</small></strong>\n          <span class=\"verdict-sub\">Fair 25.0</span>\n        </div>\n        <div class=\"verdict-col\">\n          <span class=\"verdict-label\">Edge</span>\n          <strong class=\"verdict-val font-mono text-accent\">+11.0%</strong>\n          <span class=\"verdict-sub\">+5.0% EV</span>\n        </div>\n        <div class=\"verdict-col\">\n          <span class=\"verdict-label\">Kelly Stake</span>\n          <strong class=\"verdict-val font-mono\">$150.00</strong>\n          <span class=\"verdict-sub\">3.00% cap</span>\n        </div>\n      </div>\n\n      <div class=\"detail-hero\">\n        <div class=\"detail-stat\">\n          <span>Book Offer</span>\n          <strong class=\"text-accent\">\n            <span class=\"hero-side-pill pill-over\">OVER</span>\n            2.5 <small class=\"odds-val\">-110</small>\n          </strong>\n          <small class=\"cell-sub\">Synthetic Book A · Verified</small>\n        </div>\n        <div class=\"detail-stat detail-stat-fair\">\n          <div class=\"detail-stat-head\">\n            <span>Model Fair</span>\n            <span class=\"detail-stat-badge\">P(over fair) 50.0%</span>\n          </div>\n          <strong class=\"text-white\">25.0 <small class=\"text-dim\" style=\"font-size:11px;\">(μ 30.6)</small></strong>\n          <small class=\"cell-sub\">Continuous median · 144G baseline</small>\n        </div>\n        <div class=\"detail-stat actionable\"><span>Price check</span><strong>+11.0%</strong><small class=\"cell-sub\">Return +5.0% · Stake 3.00%</small></div>\n      </div>\n\n      <div class=\"detail-sub-bar\">\n        <div class=\"detail-insight-banner\">\n          <strong>Quant Summary:</strong> Model fair price sits at 25.0 yds (+5.0% EV edge on OVER 2.5 Synthetic Book A quote).\n        </div>\n        <div class=\"detail-action-buttons\">\n          <button class=\"star-modal-btn \" type=\"button\" id=\"modalWatchlistBtn\" data-watch-player=\"00-0030035\">☆ Add to Watchlist</button>\n        </div>\n      </div>\n\n      \n\n      <!-- Unified Price Discovery & 10% Gate Hurdle Timeline -->\n      \n      <div class=\"quant-ruler-card\">\n        <div class=\"quant-ruler-header\">\n          <span class=\"quant-ruler-title\">Price Discovery &amp; 10% Gate Hurdle</span>\n          <span class=\"quant-ruler-delta text-accent\">+22.5 yds vs Offer (OVER)</span>\n        </div>\n\n        <div class=\"quant-ruler-track-wrap\">\n          <svg class=\"quant-ruler-svg\" viewBox=\"0 0 100 44\" preserveAspectRatio=\"none\" aria-hidden=\"true\">\n            <!-- Base Axis Track -->\n            <rect x=\"0\" y=\"20\" width=\"100\" height=\"4\" rx=\"1.5\" fill=\"rgba(255,255,255,0.07)\" />\n            <!-- Market Steam Vector (Open -> Offer) -->\n            <rect x=\"5.0\" y=\"20\" width=\"3.9\" height=\"4\" fill=\"rgba(148, 163, 184, 0.35)\" />\n            <!-- Actionable Alpha Zone (Offer -> Hurdle) -->\n            <rect x=\"8.9\" y=\"19\" width=\"58.9\" height=\"6\" rx=\"1\" fill=\"rgba(132, 204, 22, 0.32)\" />\n            <!-- Sub-Gate Buffer Zone (Hurdle -> Fair) -->\n            <rect x=\"67.9\" y=\"20\" width=\"21.4\" height=\"4\" fill=\"rgba(245, 158, 11, 0.22)\" />\n          </svg>\n\n          <!-- Marker 1: Open Line -->\n          <div class=\"ruler-marker marker-open\" style=\"left:5.0%\">\n            <span class=\"marker-lbl\">OPEN</span>\n            <div class=\"marker-tick tick-open\"></div>\n            <span class=\"marker-val val-open\">0.0</span>\n          </div>\n\n          <!-- Marker 2: Live Book Offer (Staggered top when crowded) -->\n          <div class=\"ruler-marker marker-offer \" style=\"left:8.9%\">\n            <span class=\"marker-lbl lbl-offer\">OFFER</span>\n            <div class=\"marker-dot dot-offer\"></div>\n            <span class=\"marker-val val-offer\">2.5</span>\n          </div>\n\n          <!-- Marker 3: Gate Hurdle Target (Staggered bottom when crowded) -->\n          <div class=\"ruler-marker marker-hurdle \" style=\"left:67.9%\">\n            <span class=\"marker-lbl lbl-hurdle\">HURDLE</span>\n            <div class=\"marker-dot dot-hurdle\"></div>\n            <span class=\"marker-val val-hurdle\">19.0</span>\n          </div>\n\n          <!-- Marker 4: Model Fair Median -->\n          <div class=\"ruler-marker marker-fair\" style=\"left:89.3%\">\n            <span class=\"marker-lbl lbl-fair\">FAIR (P50)</span>\n            <div class=\"marker-dot dot-fair\"></div>\n            <span class=\"marker-val val-fair\">25.0</span>\n          </div>\n        </div>\n\n        <p class=\"quant-ruler-copy\">\n          Playable up to <span class=\"text-amber\">19.0 yds</span> before OVER edge drops below your <span class=\"text-white\">10%</span> execution gate.\n        </p>\n      </div>\n    \n\n      <!-- What-If Simulator + Teammate Ripple Preview -->\n      \n      <div class=\"scenario-box\">\n        <div class=\"scenario-header\">\n          <h4><svg class=\"prop-icon icon-surge\" viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" style=\"width:14px;height:14px;\"><path d=\"M1.5 8h3l2-5 3.5 10 2.5-6 1.5 2.5 2-.5\"/></svg> \"What-If\" Target Share Simulator</h4>\n          <button type=\"button\" class=\"scenario-reset-btn\" id=\"scenarioResetBtn\">Reset to Model (10.6%)</button>\n        </div>\n        <p style=\"font-size:11px; color:var(--muted); margin:0 0 8px;\">Adjust target share to simulate injury vacancies or usage changes.</p>\n        <div class=\"scenario-slider-row\">\n          <input type=\"range\" id=\"targetShareSlider\" min=\"0.05\" max=\"0.45\" step=\"0.01\" value=\"0.11\">\n          <span class=\"scenario-val\" id=\"scenarioShareVal\">11%</span>\n        </div>\n        <div class=\"scenario-results\">\n          <div class=\"scenario-result-item\"><span>Sim Targets</span><strong id=\"simTargetsVal\">3.6</strong></div>\n          <div class=\"scenario-result-item\"><span>Sim Yards</span><strong id=\"simYardsVal\">30.6</strong></div>\n          <div class=\"scenario-result-item\"><span>Sim Edge</span><strong id=\"simEdgeVal\" style=\"color:var(--accent);\">OVER +11.0%</strong></div>\n        </div>\n        <div id=\"teammateRippleWrap\">\n          \n        <div class=\"teammate-ripple-bar\" id=\"teammateRipplePreview\">\n          <span class=\"ripple-lead\">Volume Concentration:</span>\n          <span class=\"ripple-text\">J. Jefferson (33.4%) · J. Jennings (19.2%)</span>\n        </div>\n        </div>\n      </div>\n    \n\n      <!-- Kelly Calculator with Gate Override -->\n      \n      <div class=\"kelly-calc-box\">\n        <div class=\"kelly-calc-header\">\n          <h4>\n            <svg class=\"prop-icon icon-volume\" viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" style=\"width:13px;height:13px;\"><path d=\"M2 10h3l3 4V2L5 6H2v4z\"/></svg>\n            Interactive Kelly Bet Sizing Calculator\n          </h4>\n          <span style=\"font: 600 10.5px/1 var(--mono); color: var(--muted);\">Kelly cap 3.0%</span>\n        </div>\n        <div class=\"kelly-calc-row\">\n          <label class=\"kelly-input-wrap\">\n            <span>Bankroll $</span>\n            <input type=\"number\" id=\"kellyBankrollInput\" min=\"100\" max=\"1000000\" step=\"100\" value=\"5000\">\n          </label>\n          <div class=\"kelly-result-card\">\n            <span class=\"kelly-stake-amt\" id=\"kellyWagerDollars\">$150.00</span>\n            <span class=\"kelly-stake-pct\" id=\"kellyWagerPct\">(3.00% of bankroll)</span>\n            \n          </div>\n        </div>\n      </div>\n    \n\n      <!-